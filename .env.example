CAPTION_CORRECTOR=qwen
QWEN_MODEL=qwen2.5:1.5b
QWEN_TIMEOUT_MS=1500
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=900
CAPTION_LANGS=vi,zh-Hans,zh-Hant
CAPTION_PORT=8420
