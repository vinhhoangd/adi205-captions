# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never contain a real key.
GEMINI_API_KEY=""
CAPTION_CORRECTION=1
CAPTION_CORRECTOR=qwen
LOCAL_MODEL=qwen2.5:1.5b       # or llama3.1:8b, gemma2:9b
LOCAL_TIMEOUT_MS=2500
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=900
CAPTION_LANGS=vi,zh-Hans,zh-Hant
CAPTION_PORT=8420
